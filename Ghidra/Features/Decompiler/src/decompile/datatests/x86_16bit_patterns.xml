<decompilertest>
<!-- Test suite for 16-bit x86 decompiler patterns commonly generated by MSC 5.x/6.x -->
<!-- These patterns appear in DOS MZ executables from the late 1980s/early 1990s -->
<binaryimage arch="x86:LE:16:Real Mode:default">
<bytechunk space="ram" offset="0x1000" readonly="true">
5589e58b5e048b07
9931d029d0b102d3
f831d029d089075d
c3909090909090905589e58b5e048b07
9931d029d0b103d3
f831d029d089075d
c3909090909090905589e58b5e048b07
99b99600f7f98917
5dc390909090909090909090909090905589e58b5e048b07
99b99600f7f98907
5dc390909090909090909090909090905589e58b5e048b07
b10ad3e8d3e080c4
0289075dc3909090
909090909090905589e58b5e048b0729
d2b105d1e0d1d2fe
c97402ebf68b5e06
89078957025dc3
</bytechunk>
<!-- Test 1: signdiv4 at 0x1000 - signed division by 4 using cwd/xor/sub/sar/xor/sub -->
<symbol space="ram" offset="0x1000" name="signdiv4"/>
<!-- Test 2: signdiv8 at 0x1020 - signed division by 8 -->
<symbol space="ram" offset="0x1020" name="signdiv8"/>
<!-- Test 3: mod150 at 0x1040 - cwd + idiv for modulus -->
<symbol space="ram" offset="0x1040" name="mod150"/>
<!-- Test 4: div150 at 0x1060 - cwd + idiv for division -->
<symbol space="ram" offset="0x1060" name="div150"/>
<!-- Test 5: addah at 0x1080 - add ah, N sub-register add -->
<symbol space="ram" offset="0x1080" name="addah"/>
<!-- Test 6: shlrcl5 at 0x10a0 - 32-bit shift via shl/rcl loop -->
<symbol space="ram" offset="0x10a0" name="shlrcl5"/>
</binaryimage>
<script>
  <!-- Test 1: Signed division by 4 -->
  <com>parse line extern void signdiv4(int2 *ptr);</com>
  <com>lo fu signdiv4</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 2: Signed division by 8 -->
  <com>parse line extern void signdiv8(int2 *ptr);</com>
  <com>lo fu signdiv8</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 3: Modulus by 150 -->
  <com>parse line extern void mod150(int2 *ptr);</com>
  <com>lo fu mod150</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 4: Division by 150 -->
  <com>parse line extern void div150(int2 *ptr);</com>
  <com>lo fu div150</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 5: Sub-register add -->
  <com>parse line extern void addah(uint2 *ptr);</com>
  <com>lo fu addah</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 6: 32-bit shift via shl/rcl loop -->
  <com>parse line extern void shlrcl5(int2 *in, int4 *out);</com>
  <com>lo fu shlrcl5</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<!-- Test 1: Signed division by 4 should produce / 4, not the xor/sub mess -->
<stringmatch name="SignedDiv4" min="1" max="1">/ 4</stringmatch>
<!-- Test 2: Signed division by 8 should produce / 8 -->
<stringmatch name="SignedDiv8" min="1" max="1">/ 8</stringmatch>
<!-- Test 3: Modulus by 150 should produce % -->
<stringmatch name="Mod150" min="1" max="1">% 0x96</stringmatch>
<!-- Test 4: Division by 150 should produce / -->
<stringmatch name="Div150" min="1" max="1">/ 0x96</stringmatch>
<!-- Test 5: Sub-register add should produce + 0x200 or equivalent, not sub-register ops -->
<stringmatch name="AddAh" min="1" max="1">\+ 0x200</stringmatch>
<!-- Test 6: shl/rcl loop - currently expected to NOT produce clean << 5 (this is a known limitation) -->
<!-- We test that it at least decompiles without error by checking for the function signature -->
<stringmatch name="ShlRcl5Exists" min="1" max="1">void shlrcl5</stringmatch>
</decompilertest>
