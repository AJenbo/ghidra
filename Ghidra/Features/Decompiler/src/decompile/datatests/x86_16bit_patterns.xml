<!-- Test 1: signdiv4 at 0x1000 - signed division by 4 using cwd/xor/sub/sar/xor/sub -->
<symbol space="ram" offset="0x1000" name="signdiv4"/>
<!-- Test 2: signdiv8 at 0x1020 - signed division by 8 -->
<symbol space="ram" offset="0x1020" name="signdiv8"/>
<!-- Test 3: mod150 at 0x1040 - cwd + idiv for modulus -->
<symbol space="ram" offset="0x1040" name="mod150"/>
<!-- Test 4: div150 at 0x1060 - cwd + idiv for division -->
<symbol space="ram" offset="0x1060" name="div150"/>
<!-- Test 5: addah at 0x1080 - add ah, N sub-register add -->
<symbol space="ram" offset="0x1080" name="addah"/>
<!-- Test 6: shlrcl5 at 0x10a0 - 32-bit shift via shl/rcl loop -->
<symbol space="ram" offset="0x10a0" name="shlrcl5"/>
<!-- Test 7: add_long_ret at 0x1100 - 32-bit add via add/adc returning in DX:AX -->
<symbol space="ram" offset="0x1100" name="add_long_ret"/>
<!-- Test 8: sub_long_ret at 0x1120 - 32-bit sub via sub/sbb returning in DX:AX -->
<symbol space="ram" offset="0x1120" name="sub_long_ret"/>
<!-- Test 9: neg_long_ret at 0x1200 - 32-bit negate via neg/sbb/neg returning in DX:AX -->
<symbol space="ram" offset="0x1200" name="neg_long_ret"/>
<!-- Test 10: shl32_1_ret at 0x1300 - 32-bit left shift by 1 via shl/rcl -->
<symbol space="ram" offset="0x1300" name="shl32_1_ret"/>
<!-- Test 11: shr32_1_ret at 0x1400 - 32-bit unsigned right shift by 1 via shr/rcr -->
<symbol space="ram" offset="0x1400" name="shr32_1_ret"/>
<!-- Test 12: sdiv2 at 0x1500 - signed division by 2 -->
<symbol space="ram" offset="0x1500" name="sdiv2"/>
<!-- Test 13: sdiv16 at 0x1520 - signed division by 16 -->
<symbol space="ram" offset="0x1520" name="sdiv16"/>
<!-- Test 14: shl4_32 at 0x1540 - 32-bit left shift by 4 (expression tree) -->
<symbol space="ram" offset="0x1540" name="shl4_32"/>
<!-- Test 15: shr4_32 at 0x1560 - 32-bit right shift by 4 (expression tree) -->
<symbol space="ram" offset="0x1560" name="shr4_32"/>
<!-- Test 16: sar1_32 at 0x1580 - signed 32-bit arithmetic right shift by 1 -->
<symbol space="ram" offset="0x1580" name="sar1_32"/>
<!-- Test 17: sar4_32 at 0x15a0 - signed 32-bit arithmetic right shift by 4 -->
<symbol space="ram" offset="0x15a0" name="sar4_32"/>
</binaryimage>
<script>
  <!-- Test 1: Signed division by 4 -->
  <com>parse line extern void signdiv4(int2 *ptr);</com>
  <com>lo fu signdiv4</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 2: Signed division by 8 -->
  <com>parse line extern void signdiv8(int2 *ptr);</com>
  <com>lo fu signdiv8</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 3: Modulus by 150 -->
  <com>parse line extern void mod150(int2 *ptr);</com>
  <com>lo fu mod150</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 4: Division by 150 -->
  <com>parse line extern void div150(int2 *ptr);</com>
  <com>lo fu div150</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 5: Sub-register add -->
  <com>parse line extern void addah(uint2 *ptr);</com>
  <com>lo fu addah</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 6: 32-bit shift via shl/rcl loop -->
  <com>parse line extern void shlrcl5(int2 *in, int4 *out);</com>
  <com>lo fu shlrcl5</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 7: 32-bit add via add/adc -->
  <com>parse line extern int4 add_long_ret(int2 lo1, int2 hi1, int2 lo2, int2 hi2);</com>
  <com>lo fu add_long_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 8: 32-bit sub via sub/sbb -->
  <com>parse line extern int4 sub_long_ret(int2 lo1, int2 hi1, int2 lo2, int2 hi2);</com>
  <com>lo fu sub_long_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 9: 32-bit negate via neg/sbb/neg -->
  <com>parse line extern int4 neg_long_ret(int2 lo, int2 hi);</com>
  <com>lo fu neg_long_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 10: 32-bit left shift by 1 via shl/rcl -->
  <com>parse line extern int4 shl32_1_ret(int2 lo, int2 hi);</com>
  <com>lo fu shl32_1_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 11: 32-bit right shift by 1 via shr/rcr -->
  <com>parse line extern uint4 shr32_1_ret(uint2 lo, uint2 hi);</com>
  <com>lo fu shr32_1_ret</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 12: Signed division by 2 -->
  <com>parse line extern int2 sdiv2(int2 x);</com>
  <com>lo fu sdiv2</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 13: Signed division by 16 -->
  <com>parse line extern int2 sdiv16(int2 x);</com>
  <com>lo fu sdiv16</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 14: 32-bit left shift by 4 -->
  <com>parse line extern int4 shl4_32(int2 lo, int2 hi);</com>
  <com>lo fu shl4_32</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 15: 32-bit right shift by 4 -->
  <com>parse line extern uint4 shr4_32(uint2 lo, uint2 hi);</com>
  <com>lo fu shr4_32</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 16: Signed 32-bit arithmetic right shift by 1 -->
  <com>parse line extern int4 sar1_32(int2 lo, int2 hi);</com>
  <com>lo fu sar1_32</com>
  <com>decompile</com>
  <com>print C</com>
  <!-- Test 17: Signed 32-bit arithmetic right shift by 4 -->
  <com>parse line extern int4 sar4_32(int2 lo, int2 hi);</com>
  <com>lo fu sar4_32</com>
  <com>decompile</com>
  <com>print C</com>
  <com>quit</com>
</script>
<!-- Test 1: Signed division by 4 should produce / 4, not the xor/sub mess -->
<stringmatch name="SignedDiv4" min="1" max="1">/ 4</stringmatch>
<!-- Test 2: Signed division by 8 should produce / 8 -->
<stringmatch name="SignedDiv8" min="1" max="1">/ 8</stringmatch>
<!-- Test 3: Modulus by 150 should produce % -->
<stringmatch name="Mod150" min="1" max="1">% 0x96</stringmatch>
<!-- Test 4: Division by 150 should produce / -->
<stringmatch name="Div150" min="1" max="1">/ 0x96</stringmatch>
<!-- Test 5: Sub-register add should produce + 0x200 or equivalent, not sub-register ops -->
<stringmatch name="AddAh" min="1" max="1">\+ 0x200</stringmatch>
<!-- Test 6: shl/rcl loop - currently expected to NOT produce clean << 5 (this is a known limitation) -->
<!-- We test that it at least decompiles without error by checking for the function signature -->
<stringmatch name="ShlRcl5Exists" min="1" max="1">void shlrcl5</stringmatch>
<!-- Test 7: 32-bit add should produce CONCAT + CONCAT, not CARRY2 -->
<stringmatch name="AddLong" min="1" max="1">CONCAT22.*\+.*CONCAT22</stringmatch>
<!-- Test 8: 32-bit sub should produce CONCAT - CONCAT, not borrow mess -->
<stringmatch name="SubLong" min="1" max="1">CONCAT22.*-.*CONCAT22</stringmatch>
<!-- Test 9: 32-bit negate should produce -CONCAT22 -->
<stringmatch name="NegLong" min="1" max="1">-CONCAT22</stringmatch>
<!-- Test 10: 32-bit shift left should produce << 1 -->
<stringmatch name="ShiftLeft32" min="1" max="1">CONCAT22.*&lt;&lt; 1</stringmatch>
<!-- Test 11: 32-bit right shift should produce >> 1 -->
<stringmatch name="ShiftRight32" min="1" max="2">CONCAT22.*>> 1</stringmatch>
<!-- Test 12: Signed division by 2 -->
<stringmatch name="SignedDiv2" min="1" max="1">/ 2</stringmatch>
<!-- Test 13: Signed division by 16 -->
<stringmatch name="SignedDiv16" min="1" max="1">/ 0x10</stringmatch>
<!-- Test 14: 32-bit left shift by 4 -->
<stringmatch name="ShiftLeft32_4" min="1" max="1">CONCAT22.*&lt;&lt; 4</stringmatch>
<!-- Test 15: 32-bit right shift by 4 (matches both unsigned and signed) -->
<stringmatch name="ShiftRight32_4" min="1" max="2">CONCAT22.*>> 4</stringmatch>
<!-- Test 16: Signed 32-bit arithmetic right shift by 1 (also counted in unsigned shift-by-1 test) -->
<stringmatch name="SignedShiftRight32_1" min="2" max="2">CONCAT22.*>> 1</stringmatch>
<!-- Test 17: Signed 32-bit arithmetic right shift by 4 is covered by ShiftRight32_4 above -->
</decompilertest>
